{
  "name": "tengu-flags",
  "private": true,
  "type": "module",
  "description": "A chrome://flags style page for the feature gates and environment variables one Claude Code release reads.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/build-data.ts",
    "gate": "node tools/gate/structure.ts && biome ci --error-on-warnings . && npm run check && npm test && npm run validate && node tools/gate/suppressions.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "validate": "node tools/validate.ts",
    "index": "node tools/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "flexsearch": "0.8.212",
    "mermaid": "12.1.0",
    "solid-js": "2.0.0-rc.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "husky": "9.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
